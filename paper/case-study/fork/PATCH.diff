+  return String(value).replace(/[a-zA-Z]/g, (ch) => {
+    const code = ch.charCodeAt(0);
+    const base = ch <= 'Z' ? 65 : 97;
+    return String.fromCharCode(((code - base + 13) % 26) + base);
+  });
