+//   NFKC（全角→半角、兼容字符规范化）→ 去零宽/软连字符 → 小写
+//   → 紧凑形式（去掉所有非字母/数字，中文逐字拆词重新连成整句）
+//   → 候选解码（Base64 / hex / ROT13，解码结果再过一遍同样的归一化）
+// 红线：纯函数、确定性、无状态、无随机、无自动生成/演化逻辑；任何异常都退化为原文扫描，
+// 绝不让归一化本身把宿主搞挂（插件红线：任何路径不抛异常）。
+const ZERO_WIDTH_RE = /[\u00ad\u200b-\u200f\u202a-\u202e\u2060-\u2064\ufeff]/g;
+const NON_WORD_RE = /[^\p{L}\p{N}]+/gu;
+const B64_RE = /[A-Za-z0-9+/]{16,}={0,2}/g;
+const HEX_RE = /\b[0-9a-fA-F]{16,}\b/g;
