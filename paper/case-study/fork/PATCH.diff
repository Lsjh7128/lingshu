+function visibleChars(value) {
+  try {
+    const s = value === null || value === undefined ? '' : String(value);
+    return s.normalize('NFKC').replace(ZERO_WIDTH_RE, '');
+  } catch { return ''; }
+}
+
+/** 紧凑形式：只留字母/数字（CJK 属字母类），用于对抗逐字插分隔符的拆词。 */
+function compactText(value) {
+  try { return visibleChars(value).toLowerCase().replace(NON_WORD_RE, ''); } catch { return ''; }
