+/**
+ * 把一段文本展开成扫描用的多重表示（全部小写 + 紧凑）：
+ *   原文归一化形式、原文紧凑形式，以及每个可解码候选（Base64 / hex / ROT13）的两种形式。
+ * 返回字符串里用 \n 分隔各表示；词表用 includes() 在整串上匹配即可。
+ * @param {string} text
+ * @returns {string}
+ */
+export function normalizeForScan(text) {
+  try {
+    const base = visibleChars(text);
+    const parts = [base.toLowerCase(), compactText(base)];
+    const candidates = [];
+    if (BUFFER) {
