# ─────────────────────────────────────────────────────────────────────────────
# LINGSHU · 环境变量示例（复制为 .env 后按需填写；.env 已被 .gitignore 排除）
#
# 本文件只列「代码里实际读取」的变量。全部为可选：不设时走代码内默认值。
# 千万不要把真实 API Key / 令牌写进本文件或提交进仓库。
# PowerShell 用法示例：
#   $env:DSH_HOME = "$env:USERPROFILE\.dsh"
#   python scripts/quickstart.py --no-open
# ─────────────────────────────────────────────────────────────────────────────

# ── 宿主 / DSH 位置 ──────────────────────────────────────────────────────────
# DSH 数据根目录（profile、插件数据、凭据都在其下）。默认：~/.dsh
DSH_HOME=<DSH_HOME>

# 插件的状态目录覆盖（state.json / memory.jsonl / audit.jsonl 写到哪）。
# 默认：$DSH_HOME/plugins/dsh-lingshu
LINGSHU_DATA_DIR=<LINGSHU_DATA_DIR>

# 宿主 node 可执行文件（仅实验/验收脚本使用；默认从 PATH 找 node）。
DSH_NODE=<NODE>

# 宿主 DSH CLI 入口（bin.js；仅实验/验收脚本使用）。
DSH_BIN=<DSH_BIN>

# ── 运行时可执行文件（实验脚本用；不设则由 PATH 提供）──────────────────────
LINGSHU_NODE=<NODE>
LINGSHU_PYTHON=<PYTHON>

# ── 插件行为开关（实验室/压测用，正常使用不需要设）────────────────────────
# 控制论层总开关：off 时锚点与前置闸短路（默认开启）。
LINGSHU_CONTROL=on

# 相变窗口的 token 覆盖（默认按模型窗口推断；压测用窄窗口）。
LINGSHU_CONTEXT_WINDOW=<TOKENS>

# 混沌注入：情感偏离度 JSON，例如 {"valence":-1}（正常路径不读）。
LINGSHU_CHAOS_DEVIATION=<JSON>

# 探针插件订阅的事件名（逗号分隔；仅 probe/ 实验使用）。
LINGSHU_PROBE_EVENTS=<EVENT,EVENT>

# ── 模型凭据（只在本机 .env 或宿主凭据文件中设置）──────────────────────────
# 真实值放在 $DSH_HOME/.credentials.yaml 或本机 .env；仓库内只允许占位值。
# 注意：仅 paper/mem0-chaos-lab 对比实验需要；主仓库（engine/tests/plugin/console）
#       运行与验收都不需要任何 API Key。
DEEPSEEK_API_KEY=YOUR_API_KEY_HERE

# ── 论文实验（mem0 对比实验用；不跑实验不需要）──────────────────────────────
MEM0_DIR=<MEM0_DIR>
MEM0_TELEMETRY=<true|false>

# ── Python 输出编码（Windows 上跑测试必须设，否则中文/Unicode 会 GBK 报错）──
PYTHONIOENCODING=utf-8
PYTHONUTF8=1
