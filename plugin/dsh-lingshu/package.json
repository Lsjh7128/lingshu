{
  "name": "dsh-lingshu",
  "version": "0.2.0",
  "description": "LINGSHU 认知插件：记忆/元认知/情感/合成/目标/关系 + 控制论层（相变/积分/UCA 前置闸）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "metacognition",
    "cognitive-architecture",
    "stpa"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "control.js",
    "goalrelation.js",
    "memorywriter.js",
    "memory-paths.js",
    "tool-gateway.js",
    "workspace.js",
    "workspace-api.js",
    "workspace-policy.js",
    "workspace-admin.mjs",
    "workspaces",
    "supply-chain.js",
    "supply-chain-policy.json",
    "sandbox-host.mjs",
    "sandbox-child.mjs",
    "client.js",
    "dashboard.js",
    "diary.js",
    "ui/",
    "cordis.patch.yml",
    "README.md",
    "PROVENANCE.md"
  ],
  "scripts": {
    "sim": "node host-sim.mjs --assert",
    "stress": "node stress.mjs --assert",
    "control": "node control-sim.mjs --assert",
    "workspace": "node workspace-sim.mjs --assert",
    "workspace:wiring": "node workspace-wiring-sim.mjs --assert",
    "workspace:api": "node workspace-api-sim.mjs --assert",
    "workspace:write": "node workspace-write-sim.mjs --assert",
    "workspace:switch": "node workspace-switch-sim.mjs --assert",
    "persona:prompt": "node persona-prompt-sim.mjs",
    "supply-chain": "node supply-chain-sim.mjs --assert",
    "supply-chain:integration": "node supply-chain-integration.mjs",
    "check:package": "node ../../scripts/check_plugin_package.mjs",
    "prepublishOnly": "node ../../scripts/check_plugin_package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lsjh7128/lingshu.git",
    "directory": "plugin/dsh-lingshu"
  },
  "bugs": {
    "url": "https://github.com/Lsjh7128/lingshu/issues"
  },
  "homepage": "https://github.com/Lsjh7128/lingshu/tree/main/plugin/dsh-lingshu#readme",
  "dsh": {
    "engines": { "dsh": ">=0.2.0-rc.2" },
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "MIT"
}
